# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GitHub REST API configuration for serverless recipe synchronization
# VITE_GITHUB_TOKEN: Personal Access Token (PAT) with repo/contents write permissions
VITE_GITHUB_TOKEN=""
VITE_GITHUB_OWNER="baobabprince"
VITE_GITHUB_REPO="ima-cookbook"
VITE_GITHUB_BRANCH="main"
